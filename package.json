{
  "name": "krocpdf-monorepo",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "KrocPDF - Dual-Engine Enterprise Document Conversion Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend-api run start:dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend-api run build",
    "labeler": "node scripts/labeler.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs --preview",
    "release:notes:first": "node scripts/generate-release-notes.mjs --first --preview",
    "release:changelog": "node scripts/generate-release-notes.mjs --write-changelog",
    "release": "node scripts/generate-release-notes.mjs"
  },
  "keywords": [
    "pdf",
    "jpg-to-pdf",
    "wasm",
    "converter",
    "privacy-first"
  ],
  "author": "KrocPDF Team",
  "license": "MIT"
}
