datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum JobStatus {
  CREATED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum JobType {
  IMAGE_TO_PDF
  MERGE_PDF
  COMPRESS_PDF
  PDF_TO_JPG
}

enum PageOrientation {
  PORTRAIT
  LANDSCAPE
  AUTO
}

enum PageMargin {
  NONE
  SMALL
  MEDIUM
  LARGE
}

enum PageSize {
  A4
  LETTER
  LEGAL
  CUSTOM
  FIT_TO_IMAGE
}

enum TransparencyMode {
  FLATTEN_WHITE
  FLATTEN_BLACK
  KEEP_TRANSPARENT
}

enum CompressionLevel {
  LOW
  MEDIUM
  HIGH
}

model ConversionJob {
  id              String          @id @default(uuid()) @db.Uuid
  status          JobStatus       @default(CREATED)
  jobType         JobType         @default(IMAGE_TO_PDF) @map("job_type")
  failureReason   String?         @map("failure_reason")
  
  // PDF Layout Configuration
  pageSize        PageSize        @default(A4) @map("page_size")
  orientation     PageOrientation @default(PORTRAIT)
  margins         PageMargin      @default(NONE)
  dpi             Int             @default(150)
  transparencyMode TransparencyMode @default(FLATTEN_WHITE) @map("transparency_mode")
  compressionLevel CompressionLevel? @map("compression_level")
  imageQuality    Int?            @map("image_quality")
  
  // Output artifact
  outputS3Key     String?         @map("output_s3_key")
  outputSizeBytes BigInt?         @map("output_size_bytes")
  
  // Relations & Tracking
  userId          String?         @map("user_id") @db.Uuid
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  files           JobFile[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  expiresAt       DateTime        @map("expires_at")

  @@index([userId])
  @@index([status, createdAt])
  @@map("conversion_jobs")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  name            String?
  avatarUrl       String?         @map("avatar_url")
  passwordHash    String?         @map("password_hash")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  jobs            ConversionJob[]

  @@map("users")
}

model JobFile {
  id              String        @id @default(uuid()) @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  job             ConversionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  sequenceOrder   Int           @map("sequence_order")
  inputS3Key      String        @map("input_s3_key")
  fileName        String        @map("file_name")
  mimeType        String        @map("mime_type")
  sizeBytes       BigInt        @map("size_bytes")
  
  // Metadata populated after header sniffing
  width           Int?
  height          Int?

  @@unique([jobId, sequenceOrder])
  @@map("job_files")
}
